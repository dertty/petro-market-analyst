# Скопируйте в .env и заполните. .env под git не попадает.
#
# ВАЖНО про приоритет: непустое значение в data/settings.json ПОБЕЖДАЕТ переменную
# окружения. Поэтому этот файл — не последняя инстанция сам по себе: сервис
# settings-seed (scripts/seed_settings.py) при каждом `docker compose up` проецирует
# значения отсюда В settings.json. Так они переживают сохранение из веб-интерфейса
# Ouroboros, которое переписывает файл целиком: значения ИЗ файла оно сохраняет,
# а жившие только в окружении — подменяет вендорскими дефолтами молча.
#
# Практический вывод: правьте здесь и делайте `docker compose up -d`. Правка прямо
# в settings.json тоже сработает, но потеряется — файл в git не попадает, а seed
# вернёт значение отсюда.

# ─── Обязательные ───────────────────────────────────────────────────────────────

# Модель по умолчанию openai/gpt-5.6-terra и обе резервные — идентификаторы каталога
# OpenRouter. Без ключа агент не сделает ни одного вызова.
OPENROUTER_API_KEY=

# Значение по умолчанию — advanced. Не задав явно, на чистой установке получаем
# рантайм с правом писать в собственный репозиторий и запускать эволюцию.
OUROBOROS_RUNTIME_MODE=light

# ─── Рекомендуемые ──────────────────────────────────────────────────────────────

# Потолок расхода в долларах. По умолчанию 10.0 — задайте осознанно.
TOTAL_BUDGET=10.0

# Бесплатный ключ EIA для скилла oil_price_forecast: https://www.eia.gov/opendata/register.php
# Выдаётся по email сразу. Без него скилл не падает, но работает на снапшоте ряда из
# своей поставки и помечает в ответе, что данные могут быть устаревшими.
EIA_API_KEY=

# Ключ GDELT Cloud для маркетплейс-скилла gdelt-mcp: https://gdeltcloud.com/auth/sign-up
# → Dashboard → API Keys. Показывается один раз. Тариф Free ($0) покрывает всё, чем
# скилл полезен здесь: события, новостные кластеры со ссылками на статьи, сущности,
# энергоактивы GEM, макрофинансовые ряды, web research. Категория prediction_market
# на Free отвечает «requires a plan with prediction markets enabled».
#
# Чего этот ключ НЕ даёт: отчётов. GDELT — новостной поток и событийный граф, MOMR,
# OMR и STEO там нет и не будет, их тянут с сайтов первоисточников.
#
# Механика отличается от остальных ключей файла, и на неё легко наступить.
# Вендорский цикл наложения окружения идёт ПО СПИСКУ СВОИХ ключей
# (config.py:1336, `for key in SETTINGS_DEFAULTS`), а GDELT_API_KEY вендор не знает
# вовсе — значит из окружения он в настройки не попадёт, сколько его ни пробрасывай.
# Работает он только записью в data/settings.json, которую делает settings-seed
# (scripts/seed_settings.py). Проброс в compose нужен, но лишь чтобы seed увидел
# значение: сам по себе рантайму он ничего не сообщает.
#
# Второе условие — owner-грант скиллу: как только ключ появляется в settings.json,
# он становится «запрошенным», и без гранта скилл уходит в not live: missing_grants.
# Грант выдаёт scripts/enable_own_skills.py и привязан он к хешу содержимого скилла,
# поэтому обновление gdelt-mcp из хаба грант сбрасывает — скрипт выдаст новый.
GDELT_API_KEY=

# Не нужен. Без него web_search уже работает через OPENROUTER_API_KEY тем же самым
# движком поиска (search.py: openrouter_server_tool = тот же gpt-5.2 с веб-поиском,
# что и у openai_responses, просто через OpenRouter). Этот ключ даёт не "поиск
# получше", а отдельный счёт от OpenAI и маршрут в обход OpenRouter — для одного
# пользователя смысла заводить второй платёжный ключ ради этого нет.
# OPENAI_API_KEY=

# Основная модель — самый нагруженный слот, на нём и стоит экономить в первую
# очередь. Вендорский дефолт x-ai/grok-4.5 ($2/$6 за M токенов) сначала сменили на
# openai/gpt-5.6-terra ($1/$6): входные токены доминируют в счёте (см. разбор
# стоимости ответа на «привет» — 46K из 46.3K токенов промпта).
#
# Теперь deepseek-v4-pro — $0.435/$0.87 за M: вдвое дешевле terra по входу и
# всемеро по выходу. Контекст те же 1 048 576, tools и structured outputs
# поддерживает (проверено по каталогу OpenRouter 2026-08-10), в списке снятых
# моделей рантайма не значится. Расчётная цена запроса на нашей статистике
# (в среднем 311K входных и 16K выходных токенов) — около $0.07 против $0.13.
#
# Минус, принятый осознанно. Рантайм разрешает OpenRouter переключать провайдеров
# ОДНОЙ И ТОЙ ЖЕ модели только для семейств с проверенной переносимостью подписи
# рассуждений — anthropic, google/gemini, openai (llm.py:72-91). deepseek и z-ai/glm
# числятся непроверенными, и как только в истории задачи появляются рассуждения,
# рантайм ставит allow_fallbacks=false и прибивает задачу к одному провайдеру.
# Вместе с выключенным кросс-модельным фолбэком (ниже) это значит: провайдер лёг —
# задача упала, подстраховки нет. На terra эта подстраховка работала.
#
# ЕСЛИ МЕНЯЕТЕ ЭТУ СТРОКУ — меняйте и OUROBOROS_MODEL_FALLBACKS на то же значение,
# иначе включится кросс-модельный фолбэк и задачи начнут умирать (запись 32).
OUROBOROS_MODEL=deepseek/deepseek-v4-pro

# Лёгкий слот. Кормит компактизацию контекста (context_compaction.py: склеивает
# раунды стенограммы в батч и просит пересказать), рефлексию, safety-проверки,
# синтез ревью и improvement-backlog. Нагрузка почти целиком входная, поэтому
# решает цена входа.
#
# Был google/gemini-3.6-flash и оказался дороже ОСНОВНОЙ модели по обеим осям —
# $1.50/$7.50 против $1.00/$6.00 у terra. «flash» у Google означает скорость, а не
# ценовой тир; тот же вывод уже был сделан для слота web_search ниже, но на лёгкий
# слот его не перенесли. По журналу вызовов flash сжёг $1.34 на 1.43M входных
# токенов, luna на сопоставимых 1.26M — $0.26, впятеро дешевле.
#
# Семейство лёгкой модели с основной пересекаться не обязано и мешать не может:
# компактизация отдаёт модели ОТРЕНДЕРЕННЫЙ текст раундов, а не сырые сообщения с
# шифрованными блоками рассуждений, так что поломка из записи 32 PROBLEMS.md тут
# не воспроизводится — она была верна и когда основной моделью была terra.
# Дешевле есть (qwen3.7-flash $0.03/$0.13), но плохой пересказ портит все
# последующие раунды задачи — на этом слоте экономия окупается хуже всего.
OUROBOROS_MODEL_LIGHT=openai/gpt-5.6-luna
# OUROBOROS_MODEL_HEAVY не используется: он для субагентов и разбора скриншотов,
# а delegate_*/schedule_subagent у нас в disabled_tools, картинок в вопросах нет.

# Кросс-модельный фолбэк — резервная модель, на которую рантайм переключает задачу,
# когда основная ответила транзиентной ошибкой. Здесь он выключен намеренно.
#
# Вендорский дефолт — openai/gpt-5.6-luna, то же семейство, что и бывшая основная
# terra. Санитайзер, который срезает рассуждения при смене модели, сравнивает только
# семейство (часть идентификатора до «/») и при совпадении оставляет историю как есть.
# Но рассуждения OpenAI — зашифрованный блок, привязанный к КОНКРЕТНОЙ модели, и luna
# его не читает: провайдер отвечает 404 «encrypted reasoning content produced under a
# different model», задача умирает с provider_unavailable. Разбор — PROBLEMS.md, 32.
# С deepseek в основном слоте семейства уже разные, санитайзер историю почистит — но
# полагаться на это незачем: слот всё равно должен быть выключен.
#
# Значение равно OUROBOROS_MODEL намеренно: get_fallback_models выбрасывает активную
# модель из цепочки, и та схлопывается в пустую — штатный способ отключить фолбэк.
# ЗНАЧИТ, ЭТА СТРОКА МЕНЯЕТСЯ ВМЕСТЕ С OUROBOROS_MODEL. Разойдясь с ней, она из
# выключателя превращается в рабочую цепочку фолбэка.
# Пустая строка эту роль НЕ играет: пустое значение переменной рантайм пропускает
# (config.py:1343-1344) и подставляет свой дефолт, то есть вернёт ровно ту поломку.
# Резервирование провайдеров внутри одной модели у OpenRouter при этом сохранялось и
# закрывало большую часть транзиентных сбоев — но с deepseek в основном слоте оно
# тоже отключается (разбор выше, у OUROBOROS_MODEL). Сейчас подстраховки нет никакой.
OUROBOROS_MODEL_FALLBACKS=deepseek/deepseek-v4-pro

# Модель, которой работает web_search, — отдельный слот с отдельным счётом.
# Инструмент не «ищет»: он запускает свой прогон модели с провайдерским плагином
# openrouter:web_search (llm.py: search_context_size=medium, max_total_results=10),
# и вся выдача поиска приезжает во входные токены ЭТОЙ модели, а не основной.
# Без явного значения берётся дефолт gpt-5.2 ($1.75/$14) — самый дорогой тариф в
# сборке. Замер на вопросе о цене нефти 2026-08-09: 4 поиска, 382K входных и 30K
# выходных токенов — $1.97 из $2.04 всей задачи, то есть 96% счёта.
# luna по таблице цен рантайма $0.20/$0.60: те же вызовы стоили бы около $0.09.
# Не gemini-3.6-flash: $1.50/$7.50, против gpt-5.2 экономия только на выходе.
# Не grok-4-fast: его нет в таблице цен рантайма, и расход по нему не settl-ится
# вовсе — вызовы остаются в состоянии unresolved и мимо учёта.
OUROBOROS_WEBSEARCH_MODEL=openai/gpt-5.6-luna

# Три модели, судящие каждый ответ. Из дефолта убран anthropic/claude-sonnet-5:
# по журналу вызовов он стоил $0.0155 за вызов против $0.0014 у luna — в 11 раз
# дороже остальных, а голос у всех троих равный. Слотов оставляем три: при двух
# кворум требует согласия обоих, и одно несогласие валило бы ревью каждый раз.
# openai/gpt-5.2 убран как $1.75/$14 — ревью тривиального ответа сжигало сотни
# токенов рассуждений по цене $14 за M. Сменивший его x-ai/grok-4-fast снят с
# каталога OpenRouter: 2026-08-09 вызовы стали отдавать 404 «Grok 4 Fast is
# deprecated», в логе задачи slot_3:degraded. Это же объясняет и прежнюю запись
# «его нет в таблице цен рантайма» — таблица не рукописная, рантайм тянет её из
# живого каталога OpenRouter (pricing.py: fetch_openrouter_pricing), и модели,
# выпавшей из каталога, в ней быть не может.
#
# На его место сначала поставили z-ai/glm-5.2 и сняли 2026-08-10. Причина не в цене:
# ЕГО ОТВЕТ НЕ ПАРСИТСЯ. Распакованный блоб ответа судьи падает на json.loads
# («Expecting ':' delimiter»), рантайм помечает голос как degraded либо
# missing_tier_coach_or_criterion_evidence. За 24 вызова слот не дал ни одного
# засчитанного голоса. Кворум по adaptive_quorum (config.py:598) требует двух валидных
# PASS из трёх, поэтому в трёх задачах из пяти прогон 20260810-023914 закрылся с
# «no valid quorum» — деньги за ревью потрачены, вердикта нет.
#
# И то же самое ломает его цену. Сверка журнала с каталогом (все ревью-вызовы,
# ожидаемое = токены × каталожный тариф):
#
#   модель                        ожидалось  фактически  разрыв
#   anthropic/claude-sonnet-5       $0.2651     $0.2636     1.0x
#   google/gemini-3.6-flash         $0.5451     $0.4770     0.9x
#   google/gemini-3.5-flash-lite    $0.2920     $0.2817     1.0x
#   openai/gpt-5.6-luna             $0.1983     $0.2066     1.0x
#   z-ai/glm-5.2                    $0.0993     $0.6685     6.7x
#
# Все, кроме glm, укладываются в каталог. glm выставляет счёт в 6,7 раза больше:
# его completion_tokens не покрывают того, за что он берёт деньги, — платятся
# скрытые токены рассуждений. Отсюда и обрыв JSON: бюджет выхода уходит в
# рассуждения, а структурированный вердикт не дописывается. Дешёвый по каталогу
# ($0.11/$0.35) слот на деле был вторым по дороговизне и при этом бесполезным.
#
# ВЫВОД, важнее конкретной замены: каталожная цена ничего не гарантирует, пока по
# модели нет своего журнала. Сверять надо ожидаемое с фактическим, а не читать
# прайс-лист.
#
# На его месте anthropic/claude-haiku-4.5 — $1.00/$5.00 по каталогу. Дороже по
# тарифу, но на объёме, который реально отработал sonnet-5 (53 314 вход / 15 852
# выход за 5 вызовов), это $0.0265 за вызов — ровно те же деньги, что стоил
# неработающий glm ($0.0279), только с засчитанным голосом. Биллинг Anthropic
# проверен: sonnet-5 сошёлся с каталогом до цента (1.0x в таблице выше).
#
# Почему не gemini-3.6-flash, который в этом рантайме тоже отработал 13 вызовов без
# сбоев формата: слоты 2 и 3 стали бы оба Google — разброс судей по разным семействам
# исчезает, и сбой одного провайдера уносит сразу два голоса из трёх. За это ещё и
# пришлось бы доплатить ($0.0367 против $0.0265).
#
# Чего у haiku-4.5 нет — своего журнала на поверхности task_acceptance. ПОСЛЕ ПЕРВОГО
# ЖЕ ПРОГОНА ПРОВЕРИТЬ, что слот даёт засчитанный голос:
#   grep "Task acceptance review" data/logs/progress.jsonl | tail
# Строка вида «slot_3:degraded» или «slot_3:missing_tier_coach_or_criterion_evidence»
# означает, что повторяется история glm. Запасной вариант — anthropic/claude-sonnet-5
# ($0.0527 за вызов, 5 вызовов без сбоев), тот же провайдер, вдвое дороже.
#
# ВАЖНО, проверено ценой ошибки: каталога OpenRouter для выбора модели НЕДОСТАТОЧНО.
# У рантайма есть свой список снятых моделей — _RETIRED_MODEL_DEFAULT_REPLACEMENTS
# в ouroboros/server_runtime.py, — и попавшее в него значение он переписывает молча,
# в том числе поэлементно внутри этого списка судей. Сюда сначала поставили
# gemini-3.1-flash-lite ($0.25/$1.50, в каталоге живой и с ценой), а рантайм подменил
# его на gemini-3.5-flash ($1.50/$9.00) — дороже по выходу, чем убираемый 3.6-flash.
# Признаков подмены нигде, кроме расхождения .env и data/settings.json, не видно.
# Перед сменой ЛЮБОЙ модели сверяться с этим списком, а после перезапуска —
# сравнивать значение в settings.json с тем, что задано здесь.
#
# Ни один слот не должен совпадать с OUROBOROS_MODEL: судья, совпавший с моделью-
# автором ответа, лишает ревью независимости. Отсюда же ограничение на будущее — если
# основной моделью станет deepseek-v4-flash или другой deepseek, состав придётся
# пересобрать. Не grok-4.3: $1.25/$2.50, для формального чекера полноразмерная
# reasoning-модель избыточна по цене за ту же роль.
OUROBOROS_REVIEW_MODELS=openai/gpt-5.6-luna,google/gemini-3.5-flash-lite,anthropic/claude-haiku-4.5

# Усилие рассуждений в задачах ревью: none | low | medium | high. Вендорский
# дефолт — high, здесь low. Значение действует сразу на все три слота судей:
# per-slot effort мы не задаём, и reviewer_slot_config берёт для строки общий
# resolve_effort("review") (config.py:560). Рассуждения оплачиваются выходными
# токенами, а роль у слотов формальная — проверить ответ по критериям, не
# переписать его. Это тот же мотив, по которому из состава убран gpt-5.2.
# Соседние ключи (OUROBOROS_EFFORT_TASK, OUROBOROS_EFFORT_SCOPE_REVIEW и
# прочие OUROBOROS_EFFORT_*) остаются на вендорских дефолтах.
OUROBOROS_EFFORT_REVIEW=low

# Модель отдельного типа задачи «глубокое саморевью» (deep_self_review). Наше
# приложение такие задачи не создаёт — POST /api/tasks идёт без поля type, — так что
# слот сейчас не расходует ничего, и в журнале вызовов по нему ноль.
#
# Задан он всё равно явно, по двум причинам. Первая: вендорский дефолт —
# openai/gpt-5.6-sol-pro по $5/$30 за M токенов, вдвое дороже премиального тира и
# больше чем в десять раз дороже основной модели; самый дорогой тариф в сборке, держать
# его заряженным «на случай» незачем. Вторая: без строки здесь ключ живёт только в
# data/settings.json, который в git не попадает и переписывается любым owner-действием
# в веб-интерфейсе (запись 31 в PROBLEMS.md) — то есть настройка была бы невидима и
# невоспроизводима на другой машине.
#
# terra, а не что-то дешевле: если тип задачи однажды появится, роль у слота
# аналитическая, и мерить его качество нам сейчас не на чем.
OUROBOROS_MODEL_DEEP_SELF_REVIEW=openai/gpt-5.6-terra

# ─── Приложение ─────────────────────────────────────────────────────────────────

# Сколько секунд рантайм ведёт задачу до принудительного мягкого завершения.
# По умолчанию в самом Ouroboros дедлайна нет вовсе (0), поэтому задаём явно.
TASK_TIMEOUT_SEC=600

# На каком порту хоста виден рантайм. 8766, а не 8765, чтобы не конфликтовать
# с нативной установкой Ouroboros, если она работает на этой же машине.
# Внутри сети Docker порт всегда 8765, приложение от этого значения не зависит.
OUROBOROS_HOST_PORT=8766

# Каталог со своими скиллами глазами рантайма. Значение — путь ВНУТРИ КОНТЕЙНЕРА:
# compose монтирует ./skills в /workspace/data/skills/external, и указывать надо
# именно смонтированный путь, а не хостовый.
#
# Зачем вообще. Инструменты скиллов работают и без этой настройки: расширения
# регистрируются и вызываются по имени (ext_<len>_<токен>_<инструмент>). А вот
# list_skills, skill_exec и skill_preflight проходят через общий префлайт
# (ouroboros/tools/skill_exec.py): он пропускает вызов, если ЛИБО задан этот путь,
# ЛИБО скиллы обнаруживаются в каталоге текущей задачи. Второе у нас никогда не
# выполняется — задачи создаются с memory_mode=forked, то есть с собственным
# пустым каталогом, куда скиллы не копируются. Пустой путь означает отказ:
#   ⚠️ SKILLS_UNAVAILABLE: No skills are discoverable.
#
# Чем это опасно. Само по себе — мелочь: агент обычно зовёт инструмент напрямую.
# Но 2026-08-10 в базу знаний легли записи (forecasting_readiness, research_execution,
# source_validation), предписывающие ПЕРЕД прогнозом проверять list_skills и при
# SKILLS_UNAVAILABLE переходить на web-фолбэк, не выдавая собственный числовой
# диапазон. В следующем же прогоне все семь forecast-вопросов ушли в фолбэк:
# расчётный модуль был жив и вызываем, но агент считал его отсутствующим.
# То есть страховка от отказа модуля сама стала причиной отказа.
OUROBOROS_SKILLS_REPO_PATH=/workspace/data/skills/external

# ─── Не нужны, перечислены чтобы не искать ──────────────────────────────────────

# OUROBOROS_NETWORK_PASSWORD — только при выносе порта 8765 за пределы localhost.
# GITHUB_TOKEN — только если включать эволюцию: агенту понадобится пушить в форк.
